Options -Indexes
DirectoryIndex index.html
RewriteEngine On

# Preserve old enquiry URLs while consolidating locale URLs. Apache 2.4 / Plesk.
RewriteCond %{QUERY_STRING} (^|&)lang=(kk|en)(&|$) [NC]
RewriteRule ^(?:kk/|en/)?(.*)$ https://acpro.kz/%2/$1 [R=301,L,QSD,NE]
RewriteCond %{THE_REQUEST} \s/+((?:kk/|en/)?)index\.html(?:[?\s]) [NC]
RewriteRule ^ https://acpro.kz/%1 [R=301,L,NE]
RewriteRule ^astana-cleaning-pro-main/(.*)$ https://acpro.kz/$1 [R=301,L,NE]
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} !^acpro\.kz$ [NC]
RewriteRule ^ https://acpro.kz%{REQUEST_URI} [R=301,L,NE]

RewriteRule ^(?:\.git|node_modules|tools|private-acpro-metrics)(?:/|$) - [F,L]
<FilesMatch "(?i)(^\.|\.zip$|\.bundle$|\.log$|\.md$|^package.*\.json$|^service-content\.json$|^seo-manifest\.json$|^bitrixsetup\.php$)">
 Require all denied
</FilesMatch>

<IfModule mod_headers.c>
 Header always set X-Content-Type-Options "nosniff"
 Header always set Referrer-Policy "strict-origin-when-cross-origin"
 <FilesMatch "\.html$">
  Header set Cache-Control "no-cache"
 </FilesMatch>
 <FilesMatch "\.(css|js|svg)$">
  Header set Cache-Control "public, max-age=604800"
 </FilesMatch>
</IfModule>
<IfModule mod_deflate.c>
 AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json application/xml image/svg+xml
</IfModule>
